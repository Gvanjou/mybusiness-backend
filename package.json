{
  "name": "mybusiness-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "job": "tsx --env-file=.env src/jobs/jobs.cli.ts",
    "test": "tsx --env-file=.env --test test/auth.test.ts test/quota.test.ts test/agent-next.test.ts test/guard.test.ts test/catalog-text.test.ts test/agent-tools.test.ts test/agent-loop.test.ts test/agent-text.test.ts test/round5.test.ts test/prompt.test.ts test/round6.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "@mapbox/vector-tile": "^2.0.5",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.14",
    "pbf": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
