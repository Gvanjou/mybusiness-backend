# ── Server ─────────────────────────────────────────────
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=

GEMINI_MODEL_LIMITS=

JOBS_SECRET=


# ── Rate limits ────────────────────────────────────────
CHAT_MESSAGES_PER_MINUTE=10
CHAT_MESSAGES_PER_DAY=200
SESSIONS_PER_HOUR=20

# ── Source data ────────────────────────────────────────
SOURCE_BASE_URL=https://mybusiness.ge

ENABLE_SCHEDULER=true

# Web search uses Gemini's own Google Search (no extra key).

# ── Models ──
# The chat's model order, most preferred first. Empty = the built-in free-tier chain, reordered at run time by each
# model's recent health and speed. On a paid key put a Pro model first and raise its limits in GEMINI_MODEL_LIMITS, e.g.
#   GEMINI_RESPONDER_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
#   GEMINI_MODEL_LIMITS={"gemini-3.1-pro-preview":{"rpm":60,"rpd":5000}}
GEMINI_RESPONDER_MODELS=

# Google Maps ratings/reviews in location analysis (an extra Gemini call per place; paid keys only).
GOOGLE_MAPS_GROUNDING=false


# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client ID ("Web application").
# Authorised redirect URI: http://localhost:3000/api/auth/callback (and https://<your domain>/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
